{
  "name": "enclave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "@/packages/*": "./packages/*",
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "dev:https": "node ./node_modules/next/dist/bin/next dev --experimental-https -H 0.0.0.0",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "test": "node --experimental-strip-types tests/runAllTests.ts",
    "lint": "eslint src packages"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5.8.2"
  }
}
