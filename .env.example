# ==============================================================================
# ENCLAVE — Environment Configuration Template
# ==============================================================================
# This template documents environment variables for running ENCLAVE.
# No real secrets or credentials should ever be committed to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment (Standard Node.js / Stateful Hosting)
# ------------------------------------------------------------------------------

# Application runtime environment ('development' | 'production' | 'test')
# Default: development
NODE_ENV=production

# Network port for the long-lived HTTP server process
# Default: 3000
PORT=3000

# Network host address binding
# Use 0.0.0.0 for containerized environments (Docker, Railway, Render)
# Default: 0.0.0.0
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Public Application URL (Client-Side Navigation & Share Links)
# ------------------------------------------------------------------------------

# Canonical public origin used to generate invite URLs and metadata
# Optional: defaults to the incoming request origin (or http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://your-enclave-domain.com
