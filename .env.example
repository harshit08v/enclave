# ==============================================================================
# ENCLAVE — Environment Configuration Template
# ==============================================================================
# This template documents environment variables for running ENCLAVE.
# No real secrets or credentials should ever be committed to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment (Standard Node.js / Stateful Hosting)
# ------------------------------------------------------------------------------

# Application runtime environment ('development' | 'production' | 'test')
# Default: development
NODE_ENV=production

# Network port for the long-lived HTTP server process
# Default: 3000
PORT=3000

# Network host address binding
# Use 0.0.0.0 for containerized environments (Docker, Railway, Render)
# Default: 0.0.0.0
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Public Application URL (Client-Side Navigation & Share Links)
# ------------------------------------------------------------------------------

# Canonical public origin used to generate invite URLs and metadata
# Optional: defaults to the incoming request origin (or http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://your-enclave-domain.com
APP_BASE_URL=https://your-enclave-domain.com

# ------------------------------------------------------------------------------
# 3. Firebase Authentication (Client & Server Admin SDK)
# ------------------------------------------------------------------------------

# Firebase Web Client Configuration (from Firebase Console -> Project Settings -> General)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK Configuration (Server-Only Token Verification)
FIREBASE_PROJECT_ID=your-project-id
# Optional: Path or inline JSON of service account credentials (if not using Application Default Credentials)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 4. Brevo Transactional Email Service (Optional / Legacy Backup)
# ------------------------------------------------------------------------------

# Brevo (Sendinblue) REST API Key (v3)
# Found in Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# Verified Sender Email configured and authenticated in Brevo
BREVO_SENDER_EMAIL=enclave.support.legal@gmail.com

# Verified Sender Display Name
BREVO_SENDER_NAME=ENCLAVE Security

# ------------------------------------------------------------------------------
# 5. Admin Control Center Configuration
# ------------------------------------------------------------------------------

# Admin username (default: admin)
ENCLAVE_ADMIN_USERNAME=admin

# Strong password for the Admin Control Center
ENCLAVE_ADMIN_PASSWORD=change-me-to-a-secure-admin-password

# ------------------------------------------------------------------------------
# 6. Distributed Ephemeral Backend (Multi-Instance / Serverless Scaling)
# ------------------------------------------------------------------------------
# Required for multi-instance deployments (Vercel, AWS ECS, Kubernetes)
# Ephemeral Redis / Upstash REST endpoints for cross-instance chamber sync.
# Leave blank for single-node / local standalone Node.js environments.
ENCLAVE_REDIS_REST_URL=
ENCLAVE_REDIS_REST_TOKEN=